# ============================================================
#  MCAC — исключения для публикации (GitHub)
# ============================================================

# ---- PlatformIO / Arduino (сборочные артефакты и кэши) ----
.pio/
.pioenvs/
.piolibdeps/
build/
*.o
*.elf
*.map
*.bin
*.hex

# ---- IDE ----
.vscode/
.idea/
.clangd/
compile_commands.json
*.code-workspace

# ---- Секреты и локальные настройки (не публиковать!) ----
# Если появятся — держать вне репозитория
secrets.h
secrets.*
*.local
.env
.env.*

# ---- ОС / мусор ----
.DS_Store
Thumbs.db
desktop.ini
*~
*.log

# ---- Архивы и тяжёлые файлы ----
*.zip
*.rar
*.7z
*.tar.gz
*.pdf.tmp

# ---- KiCad (если появятся схемы в будущем) ----
*-backups/
*.bak
*.kicad_pcb-bak
*.sch-bak
fp-info-cache
sym-lib-table

# ---- Фото замеров/стендов: перед коммитом проверять руками! ----
# (лицензионные наклейки, серийники, геометки)
# docs/img/
